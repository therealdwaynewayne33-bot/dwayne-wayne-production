############################################
# Local development environment (Windows/macOS/Linux)
############################################
#
# Copy this file to `.env.local` in the same folder and fill in values.
# Do NOT commit `.env.local` (it contains secrets).
#

# --- Backend (api-server) ---

# Postgres connection string (required when NODE_ENV=production).
# For local dev you may omit DATABASE_URL — the API uses embedded PGlite instead.
# Docker Compose example:
# DATABASE_URL=postgres://dreamframe:dreamframe@localhost:5432/dreamframe

# Optional object-mask backend (defaults to GEOMETRIC / FFmpeg disk masks).
# OBJECT_MASK_ENGINE=SAM2
# SAM2_VIDEO_MODEL=meta/sam-2-video

# Sessions (any long random string)
SESSION_SECRET=dev-only-change-me

# Replit deployment domain (optional for local dev)
# These are used only to build public URLs for Replicate to fetch.
# For local Windows dev, leave these blank AND keep demo mode enabled.
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=

# --- AI keys ---

# Replicate (required when BG_REPLACE_DEMO_MODE=false or when generating videos/scenes)
REPLICATE_API_TOKEN=

# OpenAI (optional; only used for real thumbnails; the app falls back gracefully)
OPENAI_API_KEY=

# Stock photos for Sci-Fi Builder (optional; “Find Real Pictures” uses server-side search only)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Creative Library — Pixabay Music / Sound Effects in the browser (mirror PIXABAY_API_KEY).
VITE_PIXABAY_API_KEY=

# Luma: this project uses Luma via Replicate models (no separate LUMA key needed here)

# --- Feature flags ---

# Unified render mode:
# local       => default — real FFmpeg locked-reference color match & local pipelines (no paid AI for color-match)
# mock        => fast EQ-only test encode (does NOT match reference style — for wiring/smoke tests only)
# production  => paid AI providers enabled where applicable
RENDER_MODE=local

# Mock locked-color pipeline: FFmpeg wall-clock cap and max seconds of input to process (fast, no full-file hash).
MOCK_RENDER_TIMEOUT_MS=60000
MOCK_RENDER_MAX_INPUT_SECONDS=12

# Dev-only color-match trim (omit or 0). Ignored when NODE_ENV=production so deploys cannot be shortened accidentally.
COLOR_MATCH_TEST_SECONDS=0

# Client poll timeout for /api/render/status (Video → Video, min 10m default). Read by Vite at build/dev time.
RENDER_POLL_TIMEOUT_MS=600000

# Background Replace demo mode (recommended ON for local dev without public domain)
BG_REPLACE_DEMO_MODE=false

# Optional paid-provider keys for production mode
LUMA_API_KEY=
GOOGLE_API_KEY=
RUNWAY_API_KEY=

